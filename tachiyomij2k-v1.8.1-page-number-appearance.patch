diff --git a/.github/workflows/build_custom_apk.yml b/.github/workflows/build_custom_apk.yml
new file mode 100644
index 0000000..484d0c8
--- /dev/null
+++ b/.github/workflows/build_custom_apk.yml
@@ -0,0 +1,38 @@
+name: Build customized APK
+
+on:
+  push:
+    branches:
+      - custom-page-number
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  build:
+    runs-on: ubuntu-24.04
+    steps:
+      - name: Check out source
+        uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+
+      - name: Set up Java
+        uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: '21'
+
+      - name: Set up Gradle
+        uses: gradle/actions/setup-gradle@v4
+
+      - name: Build separately installable APK
+        run: ./gradlew assembleStandardDebug
+
+      - name: Make APK downloadable
+        uses: actions/upload-artifact@v4
+        with:
+          name: tachiyomij2k-custom-debug-apk
+          path: app/build/outputs/apk/standard/debug/*universal*.apk
+          if-no-files-found: error
